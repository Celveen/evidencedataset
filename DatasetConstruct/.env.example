# Copy this file to DatasetConstruct/.env and fill in real keys.
# Real keys belong ONLY in .env (which is gitignored). This example file is
# committed, so never put a real key here.
# Environment variables that are already exported take precedence over .env.

# ---- Step 1: policy VLM served locally by vLLM (serve_policy_vllm.sh) ----
# vLLM checks this key; the same value is passed to the servers and the client.
LOCAL_QWEN_API_KEY=local

# ---- Steps 4-5: answer-support judge and rationale model ----
# Default provider: DeepSeek via its OpenAI-compatible endpoint. To switch models,
# edit verifier.support.generation / rationale.generation in configs/base.yaml
# (provider, model, base_url, api_key_env) and add the matching variable here.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- Only needed if you switch a provider to one of these ----
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx        # Kimi via platform.moonshot.cn (OpenAI protocol)
# KIMI_CODE_API_KEY=sk-xxxxxxxxxxxxxxxx       # Kimi Code / coding-plan key (Anthropic protocol)
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
