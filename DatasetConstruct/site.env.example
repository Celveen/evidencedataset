# Machine-specific settings for the serving / download scripts.
# Copy to DatasetConstruct/site.env (gitignored) and adapt; the scripts read it
# when present. Keep internal hostnames, paths and GPU plans out of the repository.

# Where model weights live (the scripts default to <repo>/models).
# WEIGHTS_DIR=/path/to/shared/weights

# vLLM container image (default: the public vllm/vllm-openai:v0.11.2).
# VLLM_IMAGE=registry.example.com/vllm:0.11.2

# GPUs for each server, and GPUs no EvidenceTree server may use (other jobs).
# POLICY_GPUS=0,1,2,3
# RATIONALE_GPUS=0,1,2,3
# RESERVED_GPUS=4,5,6,7

# vLLM memory fraction; lower it when another process shares a GPU.
# GPU_MEM=0.80
